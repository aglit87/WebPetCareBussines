# Set to "false" to disable MSW and send requests to the real backend
# (proxied by Vite dev server at /api -> http://localhost:5000, see vite.config.ts).
VITE_USE_MSW=true

# --- server/gateway.ts (production BFF, not read by the browser bundle) ---
# Real backend URL the gateway proxies /api/auth/* to. Never exposed to the client.
AUTH_BACKEND_URL=http://localhost:5000
# Port the gateway process listens on.
GATEWAY_PORT=4000
